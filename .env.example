# API Config
PROJECT_NAME=Multimaodal RAG
API_V1_STR=/api/v1

# Copy this file to .env and fill in both keys. Never commit .env.

# Google AI Studio  ->  https://aistudio.google.com/apikey
# Used for: vision enrichment (Gemini 2.5 Flash) + embeddings (text-embedding-004)
GOOGLE_API_KEY=

# Groq Console  ->  https://console.groq.com/keys
# Used for: fallback answering when Gemini is rate limited or down
GROQ_API_KEY=

# --- Qdrant (defaults match docker-compose.yml; no need to change) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=multimodal_rag

# --- Local paths ---
DATA_DIR=data
ARTIFACT_DIR=artifacts

# --- Free-tier throttle ---
# Seconds to sleep between Gemini vision calls during ingestion.
# 4.5s keeps you near ~13 requests/min, safely under the free-tier limit.
GEMINI_SLEEP_SECONDS=4.5
